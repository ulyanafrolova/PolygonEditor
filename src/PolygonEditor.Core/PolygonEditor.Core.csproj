<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-independent part: data model, geometry, constraints, rasterization.
       No WinForms dependency, so it builds and is testable on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PolygonEditor.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Model mutators are internal (only SceneEditor changes the scene); tests may use them directly. -->
    <InternalsVisibleTo Include="PolygonEditor.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in documentation shown by the application (F1). -->
    <EmbeddedResource Include="Documentation\*.md" LogicalName="Documentation.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
